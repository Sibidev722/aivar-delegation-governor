# Application Configuration
PROJECT_NAME="Delegation Chain Governor"
VERSION="1.0.0"
ENVIRONMENT="development" # development | production | test
DEBUG=false
HOST="0.0.0.0"
PORT=8000

# MongoDB Configuration (Atlas or local)
MONGODB_URI="mongodb+srv://<username>:<password>@cluster0.mongodb.net/delegation_governor"
MONGODB_DB_NAME="delegation_governor"

# Google Gemini LLM Configuration
GEMINI_API_KEY="YOUR_GEMINI_API_KEY_HERE"
GEMINI_MODEL="gemini-3.6-flash"

# CORS Configuration (comma-separated or JSON list)
CORS_ORIGINS='["http://localhost:3000", "http://localhost:5173", "http://127.0.0.1:5173", "https://your-frontend.vercel.app"]'

# Ed25519 Cryptographic Keys (Hex-encoded 32-byte seeds/keys)
# In production, provide a fixed hex string (64 characters hex = 32 bytes).
ED25519_PRIVATE_KEY_HEX="1337133713371337133713371337133713371337133713371337133713371337"

# Delegation Policy Controls
MAX_DELEGATION_DEPTH=4
DEFAULT_TOKEN_TTL_SECONDS=300
HTTP_TIMEOUT_SECONDS=60.0
LLM_TIMEOUT_SECONDS=45.0
